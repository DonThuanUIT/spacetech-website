# Copy to .env. Use a different password and secret for each deployment.
DATABASE_URL="postgresql://spacetech:replace_database_password@localhost:5432/spacetech?schema=public"
POSTGRES_PASSWORD="replace_database_password"
AUTH_SECRET="replace_with_random_secret_at_least_32_characters"
APP_URL="http://localhost:3000"
UPLOAD_DIR="./data/uploads"
# Enable only when real data and the public HTTPS website are ready.
INDEX_PUBLIC_SITE="false"
# Public deployment: use 127.0.0.1 and set SITE_DOMAIN to your real domain.
WEB_BIND_ADDRESS="0.0.0.0"
SITE_DOMAIN=""
# Temporary admin bootstrap variables; remove the password after creation.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="SpaceTech Admin"
